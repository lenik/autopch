# SPDX-License-Identifier: AGPL-3.0-or-later
# stub — align with debian/control and Meson install
pkgname=autopch
pkgver=0.0.0
pkgrel=1
pkgdesc="Cluster headers into balanced PCH sets for C/C++ builds"
arch=('x86_64')
url="https://github.com/lenik/autopch"
license=('AGPL-3.0-or-later')
depends=('bas-c' 'glib2')
makedepends=('meson' 'ninja' 'pkgconf' 'asciidoctor')
source=()
sha256sums=()

pkgver() {
  cd "$startdir/../.."
  zfr version 2>/dev/null | sed 's/^v//' || head -n1 VERSION
}

build() {
  cd "$startdir/../.."
  meson setup build-arch --prefix=/usr --buildtype=plain
  meson compile -C build-arch
}

package() {
  cd "$startdir/../.."
  DESTDIR="$pkgdir" meson install -C build-arch
}
